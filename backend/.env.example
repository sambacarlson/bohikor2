# Environment
ENV=development
PORT=8080

# Database (Neon PostgreSQL)
DATABASE_URL=postgres://user:password@ep-xxx-xxx.region.aws.neon.tech/bohikor2?sslmode=require

# JWT Auth
JWT_SECRET=change-me-in-production-at-least-32-chars
JWT_ACCESS_EXPIRY=15m

# Africa's Talking SMS (Sandbox for development)
AFRICASTALKING_API_KEY=your_africas_talking_api_key
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_SENDER_ID=Bohikor
AFRICASTALKING_BASE_URL=https://api.sandbox.africastalking.com/v1

# Campay (Sandbox for development)
CAMPAY_PERMANENT_ACCESS_TOKEN=your_campay_permanent_access_token
CAMPAY_WEBHOOK_SECRET=your_campay_webhook_secret
CAMPAY_BASE_URL=https://demo.campay.net/api

# Resend (Email)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=noreply@bohikor2.com

# Timezone (Cameroon)
TIMEZONE=Africa/Douala

# Server Timeouts
READ_TIMEOUT=15s
WRITE_TIMEOUT=15s
IDLE_TIMEOUT=60s
